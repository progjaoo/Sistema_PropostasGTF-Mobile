{
  "expo": {
    "name": "Mosaico Propostas",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/mosaico-icon.png",
    "scheme": "gtfpropostas",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/mosaico-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F25017"
    },
    "ios": {
      "bundleIdentifier": "br.com.grupogtf.propostas",
      "supportsTablet": false
    },
    "android": {
      "package": "br.com.grupogtf.propostas"
    },
    "web": {
      "favicon": "./assets/images/mosaico-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
